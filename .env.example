APP_NAME="Clínica Vida Salud"
APP_ENV=local
APP_DEBUG=false
APP_TIMEZONE=America/La_Paz

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=clinica_vida_salud_dev
DB_USER=postgres
DB_PASSWORD=

# Solo al configurar PostgreSQL remoto con TLS verificado en el alojamiento elegido.
# Mantener comentado en desarrollo si PostgreSQL local no ofrece TLS/CA.
# PGSSLMODE=verify-full
# PGSSLROOTCERT=

# Docker/Render: valores públicos; PORT lo proporciona Render (predeterminado 10000).
# En el Dashboard inyectar APP_ENV=production y las DB_* de la NUEVA base.
# DATABASE_URL no se interpreta: configurar DB_HOST/PORT/NAME/USER/PASSWORD por separado.
# Conexión INTERNA Render, misma región: PGSSLMODE=require (certificado interno autofirmado).
# Consola EXTERNA: verify-full y CA pública local; ver docs/ciclo1/DESPLIEGUE_RENDER.md.
# PORT=10000
